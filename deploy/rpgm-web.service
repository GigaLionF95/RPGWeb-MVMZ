[Unit]
Description=rpgm-web (RPG Maker MV/MZ browser player)
After=network.target

[Service]
User=rpgm
Group=rpgm
WorkingDirectory=/opt/rpgm-web
Environment=RPGM_DATA=/opt/rpgm-web/data
Environment=RPGM_HOST=127.0.0.1
Environment=RPGM_PORT=34210
Environment=RPGM_MAX_UPLOAD_GB=8
ExecStart=/usr/bin/node /opt/rpgm-web/app/bin/rpgm-web.js serve
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/rpgm-web/data

[Install]
WantedBy=multi-user.target
